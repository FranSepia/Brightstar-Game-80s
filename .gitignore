node_modules
dist
*.code-workspace

# Las claves de Supabase. La anon key es pública por diseño (viaja en el
# bundle), pero el archivo igual no se sube: cada entorno pone la suya y nadie
# se tienta con dejar ahí una service_role.
.env
.env.*
!.env.example

# Arte que el juego no usa, apartado acá para que no se publique ni se
# versione. Lo que tenga prefijo BORRAR- es material de terceros que quedó del
# arranque del proyecto: no se usa en ninguna parte y hay que borrarlo del
# disco, no solo dejarlo fuera del repo.
arte-sin-usar/
